# ===== 运行时生成（安装后产生，不入库） =====
.env
config/install.lock
runtime/*
!runtime/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
storage/*
!storage/.gitkeep
database/migrations/*.lock

