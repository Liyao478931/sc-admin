.splash{width:100vw;height:100vh;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}.splash-img{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1}.splash-video{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;-o-object-fit:cover;object-fit:cover}.splash-text{position:absolute;text-align:center;z-index:3}.skip-btn{position:absolute;right:20px;top:50px;padding:8px 20px;border-radius:24px;font-size:14px;z-index:10;min-width:60px;text-align:center}.timer{position:absolute;bottom:40px;left:50%;transform:translate(-50%);color:rgba(255,255,255,.3);font-size:12px;z-index:3;background:rgba(0,0,0,.1);padding:2px 12px;border-radius:10px}