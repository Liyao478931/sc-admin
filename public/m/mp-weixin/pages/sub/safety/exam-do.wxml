<view class="exam-do-page data-v-0eb82d28"><view class="top-bar data-v-0eb82d28"><view class="top-left data-v-0eb82d28">{{a}}</view><view class="top-progress data-v-0eb82d28">第 {{b}} / {{c}} 题</view><view class="{{['top-time', 'data-v-0eb82d28', e && 'urgent']}}">{{d}}</view></view><scroll-view wx:if="{{f}}" class="question-scroll data-v-0eb82d28" scroll-y><view class="question-card data-v-0eb82d28"><view class="q-head data-v-0eb82d28"><text class="q-type data-v-0eb82d28">{{g}}</text><view class="{{['q-mark', 'data-v-0eb82d28', i && 'marked']}}" bindtap="{{j}}" style="display:flex;align-items:center"><m-icon wx:if="{{h}}" class="data-v-0eb82d28" u-i="0eb82d28-0" bind:__l="__l" u-p="{{h}}"/><text class="data-v-0eb82d28" style="margin-left:4px">标记</text></view></view><view class="q-text data-v-0eb82d28">{{k}}</view><view wx:if="{{l}}" class="option-list data-v-0eb82d28"><view wx:for="{{m}}" wx:for-item="opt" wx:key="c" class="{{['option-item', 'data-v-0eb82d28', opt.d && 'selected']}}" bindtap="{{opt.e}}"><text class="option-label data-v-0eb82d28">{{opt.a}}</text><text class="option-text data-v-0eb82d28">{{opt.b}}</text></view></view><view wx:else class="option-list data-v-0eb82d28"><view class="{{['option-item', 'data-v-0eb82d28', n && 'selected']}}" bindtap="{{o}}"><text class="option-label data-v-0eb82d28">对</text><text class="option-text data-v-0eb82d28">正确</text></view><view class="{{['option-item', 'data-v-0eb82d28', p && 'selected']}}" bindtap="{{q}}"><text class="option-label data-v-0eb82d28">错</text><text class="option-text data-v-0eb82d28">错误</text></view></view></view></scroll-view><view wx:elif="{{r}}" class="empty data-v-0eb82d28">暂无题目</view><view class="bottom-bar data-v-0eb82d28"><view class="btn prev data-v-0eb82d28" bindtap="{{s}}">上一题</view><view class="btn card data-v-0eb82d28" bindtap="{{t}}">答题卡</view><view class="btn next data-v-0eb82d28" bindtap="{{v}}">下一题</view><view class="btn submit data-v-0eb82d28" bindtap="{{w}}">交卷</view></view><view wx:if="{{x}}" class="mask data-v-0eb82d28" bindtap="{{D}}"><view class="sheet data-v-0eb82d28" catchtap="{{C}}"><view class="sheet-title data-v-0eb82d28">答题卡（已答 {{y}} / {{z}}）</view><scroll-view class="grid-scroll data-v-0eb82d28" scroll-y><view class="grid data-v-0eb82d28"><view wx:for="{{A}}" wx:for-item="q" wx:key="b" class="{{['cell', 'data-v-0eb82d28', q.c && 'answered', q.d && 'marked']}}" bindtap="{{q.e}}">{{q.a}}</view></view></scroll-view><view class="legend data-v-0eb82d28"><text class="lg data-v-0eb82d28"><text class="dot answered data-v-0eb82d28"></text>已答</text><text class="lg data-v-0eb82d28"><text class="dot data-v-0eb82d28"></text>未答</text><text class="lg data-v-0eb82d28"><text class="dot marked data-v-0eb82d28"></text>标记</text></view><view class="btn confirm data-v-0eb82d28" bindtap="{{B}}">关闭</view></view></view></view>